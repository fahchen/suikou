#!/bin/sh

# Suikou uses no distributed Erlang: the CLI reaches the server over its
# loopback HTTP API. A release boot therefore starts no node name, so a second
# boot (a CLI word, the detached server) never fails on a name that another
# node holds. An explicit RELEASE_DISTRIBUTION still wins.
RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
export RELEASE_DISTRIBUTION
